        "present": "address"
      }
    },
    "address.dnsZoneResourceId": {
      "type": [
        "string",
        "boolean",
        "object",
        "null"
      ],
      "title": "address.dnsZoneResourceId",
      "requires": {
        "path": "address.dnsMode",
        "equals": "AzureDns"
