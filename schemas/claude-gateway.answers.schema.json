      "type": "string",
      "enum": [
        "interactive",
        "device",
        "helper"
      ],
      "title": "AuthMode"
    },
    "BusinessUnits": {
      "type": "array",
      "title": "Business units with teams",
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "monthlyUsdBudget",
          "mode"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "group": {
            "type": "string",
            "pattern": "^[^,:'\u2019]+$"
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "monthlyUsdBudget": {
            "type": "number",
            "minimum": 0
          },
          "mode": {
            "type": "string",
            "enum": [
              "Strict",
              "Allowance",
              "Notify"
            ]
          },
          "percent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "CallsPerMinute": {
      "type": "integer",
      "minimum": 0,
      "title": "CallsPerMinute"
    },
    "DeployProjection": {
