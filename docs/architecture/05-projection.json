{
  "version": 1,
  "id": "projection-freshness",
  "kind": "flow",
  "title": "Projection records persist until sync changes them",
  "subtitle": "A complete directory observation writes persistent entitlement records. Snapshots have an apply-by limit, the gateway bounds cache misses, and switching requires recent full-sync evidence plus resolver validation.",
  "width": 1280,
  "height": 1700,
  "outputs": [
    "docs/images/architecture/projection-freshness.png"
  ],
  "sources": [
    "sync/src/graph.mjs",
    "sync/src/plan.mjs",
    "sync/src/apply-projection.mjs",
    "sync/src/apply-lock.mjs",
    "resolver/src/index.mjs",
    "resolver/src/lookup.mjs",
    "resolver/src/entitlement.mjs",
    "infra/policy.xml",
    "infra/resolver.bicep",
    "infra/projection.bicep",
    "infra/projection-network.bicep",
    "infra/projection-renewal.bicep",
    "sync/Dockerfile",
    "sync/src/check-admission.mjs",
    "infra/projection-registry.bicep",
    "infra/projection-renewal-gateway-reader.bicep",
    "sync/src/business-units.mjs",
    "sync/src/events.mjs",
    "scripts/Deploy-ClaudeProjectionRenewal.ps1",
    "scripts/ClaudeProjectionSwitch.ps1",
    "scripts/Sync-ClaudeAccess.ps1",
    "scripts/ClaudeRunner.ps1"
  ],
  "identifiers": {
    "snapshot": {
      "label": "Sync-ClaudeProjection.ps1",
      "source": "scripts/Sync-ClaudeProjection.ps1",
      "kind": "file"
    },
    "next": {
      "label": "@odata.nextLink",
      "source": "sync/src/graph.mjs",
      "match": "page['@odata.nextLink']"
    },
    "reconcile": {
      "label": "createReconciliation",
      "source": "sync/src/plan.mjs",
      "match": "export function createReconciliation("
    },
    "generation": {
      "label": "reconciliationGeneration",
      "source": "sync/src/plan.mjs",
      "match": "reconciliationGeneration: randomUUID()"
    },
    "verified": {
      "label": "lastVerifiedAt",
      "source": "sync/src/plan.mjs",
      "match": "lastVerifiedAt: new Date(start).toISOString()"
    },
    "expiry": {
      "label": "snapshot apply-by",
      "source": "sync/src/plan.mjs",
      "match": "expiresAt = Math.floor(start / 1000) + maxAgeSeconds"
    },
    "writer": {
      "label": "apply-projection.mjs",
      "source": "sync/src/apply-projection.mjs",
      "kind": "file"
    },
    "fetch": {
      "label": "fetchNext()",
      "source": "sync/src/apply-projection.mjs",
      "match": "await iterator.fetchNext()"
    },
    "upsert": {
      "label": "executeBulkOperations",
      "source": "sync/src/apply-projection.mjs",
      "match": "container.items.executeBulkOperations("
    },
    "apply-lock": {
      "label": "projection-apply-lock",
      "source": "sync/src/apply-lock.mjs",
      "match": "export async function acquireApplyLock"
    },
    "lookup": {
      "label": "createLookup",
      "source": "resolver/src/lookup.mjs",
      "match": "export function createLookup("
    },
    "to-entitlement": {
      "label": "toEntitlement",
      "source": "resolver/src/entitlement.mjs",
      "match": "export function toEntitlement("
    },
    "route": {
      "label": "entitlement/{oid}",
      "source": "resolver/src/index.mjs",
      "match": "route: 'entitlement/{oid}'"
    },
    "ttl": {
      "label": "entitlement-cache-seconds",
      "source": "infra/policy.xml",
      "match": "{{entitlement-cache-seconds}}"
    },
    "misses": {
      "label": "entitlement-misses",
      "source": "infra/policy.xml",
      "match": "counter-key=\"entitlement-misses\""
    },
    "key": {
      "label": "ent:v2:<tenant>:<oid>",
      "source": "infra/policy.xml",
      "match": "ent:v2:{{tenant-id}}:"
    },
    "inbound": {
      "label": "inboundAccess",
      "source": "infra/resolver.bicep",
      "match": "param inboundAccess string = 'private'"
    },
    "network": {
      "label": "networkAccess",
      "source": "infra/projection.bicep",
      "match": "param networkAccess string = 'private-only'"
    },
    "auth": {
      "label": "authsettingsV2",
      "source": "infra/resolver.bicep",
      "match": "name: 'authsettingsV2'"
    },
    "renewal-template": {
      "label": "projection-renewal.bicep",
      "source": "infra/projection-renewal.bicep",
      "kind": "file"
    },
    "acr": {
      "label": "ACR registry",
      "source": "infra/projection-registry.bicep",
      "match": "resource acr 'Microsoft.ContainerRegistry/registries@2023-07-01' = {"
    },
    "cae-job": {
      "label": "Container Apps job",
      "source": "infra/projection-renewal.bicep",
      "match": "Microsoft.App/jobs@2024-03-01"
    },
    "cae-env": {
      "label": "Container Apps env",
      "source": "infra/projection-renewal.bicep",
      "match": "Microsoft.App/managedEnvironments@2024-03-01"
    },
    "renewal-identity": {
      "label": "renewal identity",
      "source": "infra/projection-registry.bicep",
      "match": "resource identity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {"
    },
    "cosmos-writer": {
      "label": "Cosmos writer role",
      "source": "infra/projection-renewal.bicep",
      "match": "databaseAccounts/sqlRoleAssignments@2024-05-15"
    },
    "renewal-alerts": {
      "label": "alerts and action group",
      "source": "infra/projection-renewal.bicep",
      "match": "Microsoft.Insights/scheduledQueryRules@2023-12-01"
    },
    "admission-check": {
      "label": "check-admission.mjs",
      "source": "sync/src/check-admission.mjs",
      "kind": "file"
    },
    "registry-template": {
      "label": "projection-registry.bicep",
      "source": "infra/projection-registry.bicep",
      "kind": "file"
    },
    "deploy-renewal": {
      "label": "Deploy-ClaudeProjectionRenewal.ps1",
      "source": "scripts/Deploy-ClaudeProjectionRenewal.ps1",
      "kind": "file"
    },
    "unit-reader": {
      "label": "named-value reader role",
      "source": "infra/projection-renewal-gateway-reader.bicep",
      "match": "'Microsoft.ApiManagement/service/namedValues/read'"
    },
    "unit-read": {
      "label": "bu-registry read",
      "source": "sync/src/business-units.mjs",
      "match": "export async function readGatewayUnits("
    },
    "renewal-logs": {
      "label": "diagnostic setting",
      "source": "infra/projection-renewal.bicep",
      "match": "Microsoft.Insights/diagnosticSettings@2021-05-01-preview"
    },
    "switch": {
      "label": "Invoke-ClaudeProjectionSwitch",
      "source": "scripts/ClaudeProjectionSwitch.ps1",
      "match": "function Invoke-ClaudeProjectionSwitch {"
    },
    "sync-access": {
      "label": "Sync-ClaudeAccess.ps1",
      "source": "scripts/Sync-ClaudeAccess.ps1",
      "kind": "file"
    },
    "runner-start": {
      "label": "Start-ClaudeProjectionRunner",
      "source": "scripts/ClaudeRunner.ps1",
      "match": "function Start-ClaudeProjectionRunner"
    },
    "compare-snapshot": {
      "label": "--compare-snapshot",
      "source": "sync/src/apply-projection.mjs",
      "match": "--compare-snapshot"
    },
    "entitlement-source": {
      "label": "entitlement-source",
      "source": "infra/policy.xml",
      "match": "{{entitlement-source}}"
    }
  },
  "groups": [
    {
      "x": 0,
      "y": 0,
      "w": 394,
      "h": 510,
      "tone": "slate",
      "title": "Directory observation · outside or inside VNet"
    },
    {
      "x": 430,
      "y": 0,
      "w": 850,
      "h": 510,
      "tone": "teal",
      "title": "Private VNet · separate writer identity"
    },
