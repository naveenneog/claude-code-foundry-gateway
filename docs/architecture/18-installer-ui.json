{
  "version": 1,
  "id": "installer-ui",
  "kind": "flow",
  "title": "Installer UI: local server, static fallback and run record",
  "subtitle": "One local Node server and one static page share the UI model, call repository PowerShell seams, gate runs on preflight fingerprints and stream redacted installer progress.",
  "width": 1440,
  "height": 1080,
  "outputs": [
    "docs/images/architecture/installer-ui.png"
  ],
  "sources": [
    "tools/installer-ui/server.mjs",
    "tools/installer-ui/run-record.mjs",
    "tools/installer-ui/run-admission.mjs",
    "tools/installer-ui/installer-stream.mjs",
    "tools/installer-ui/run-transport.mjs",
    "tools/installer-ui/installer-contract.mjs",
    "tools/installer-ui/preflight-record.mjs",
    "tools/installer-ui/session-auth.mjs",
    "tools/installer-ui/azure-lease.mjs",
    "tools/installer-ui/child-output.mjs",
    "tools/installer-ui/step-scope.mjs",
    "tools/installer-ui/server-model.mjs",
    "tools/installer-ui/http-helpers.mjs",
    "tools/installer-ui/installer-ui.js",
    "tools/installer-ui/installer-ui-actions.js",
    "tools/installer-ui/installer-ui-business-units.js",
    "tools/installer-ui/installer-ui-prefill.js",
    "tools/installer-ui/installer-ui-problems.js",
    "tools/installer-ui/installer-ui-run.js",
    "tools/installer-ui/installer-ui-render.js",
    "tools/installer-ui/ui-model.js",
    "tools/installer-ui/index.html",
    "schemas/claude-gateway.answers.schema.json",
    "scripts/Get-ClaudeInstallerUiIdentity.ps1",
    "scripts/Get-ClaudeInstallerUiPrefill.ps1",
    "scripts/ClaudeGatewayAddressInput.ps1",
    "scripts/ClaudeInstallSteps.ps1",
    "scripts/ClaudeInstallerPreflight.ps1",
    "Install-ClaudeGateway.ps1",
    "scripts/ClaudeInstallResume.ps1"
  ],
  "identifiers": {
    "server": { "label": "server.mjs", "source": "tools/installer-ui/server.mjs", "match": "createInstallerUiServer" },
    "session": { "label": "session-auth.mjs", "source": "tools/installer-ui/session-auth.mjs", "match": "issueSecret" },
    "lease": { "label": "azure-lease.mjs", "source": "tools/installer-ui/azure-lease.mjs", "match": "createAzureLease" },
    "child-output": { "label": "child-output.mjs", "source": "tools/installer-ui/child-output.mjs", "match": "collectChildOutput" },
    "step-scope": { "label": "step-scope.mjs", "source": "tools/installer-ui/step-scope.mjs", "match": "validateRunRequest" },
    "http": { "label": "http-helpers.mjs", "source": "tools/installer-ui/http-helpers.mjs", "match": "assertSameOrigin" },
    "browser": { "label": "installer-ui.js", "source": "tools/installer-ui/installer-ui.js", "match": "runHost" },
    "browser-run": { "label": "installer-ui-run.js", "source": "tools/installer-ui/installer-ui-run.js", "match": "streamRun" },
    "browser-render": { "label": "installer-ui-render.js", "source": "tools/installer-ui/installer-ui-render.js", "match": "renderCommands" },
    "model": { "label": "ui-model.js", "source": "tools/installer-ui/ui-model.js", "match": "collectAnswersFromEntries" },
    "static": { "label": "index.html", "source": "tools/installer-ui/index.html", "match": "schema-json" },
    "schema": { "label": "answers schema", "source": "schemas/claude-gateway.answers.schema.json", "match": "Claude gateway answers" },
    "server-model": { "label": "server-model.mjs", "source": "tools/installer-ui/server-model.mjs", "match": "loadUiModel" },
    "identity": { "label": "Get-ClaudeInstallerUiIdentity.ps1", "source": "scripts/Get-ClaudeInstallerUiIdentity.ps1", "match": "az account show" },
    "prefill": { "label": "Get-ClaudeInstallerUiPrefill.ps1", "source": "scripts/Get-ClaudeInstallerUiPrefill.ps1", "match": "cognitiveservices" },
    "address-input": { "label": "ClaudeGatewayAddressInput.ps1", "source": "scripts/ClaudeGatewayAddressInput.ps1", "match": "AddressCertificateSource" },
    "fingerprint": { "label": "preflight-record.mjs", "source": "tools/installer-ui/preflight-record.mjs", "match": "preflightFingerprint" },
    "contract": { "label": "installer-contract.mjs", "source": "tools/installer-ui/installer-contract.mjs", "match": "validateProgressEvent" },
    "record": { "label": "run-record.mjs", "source": "tools/installer-ui/run-record.mjs", "match": "createRunRecord" },
    "admission": { "label": "run-admission.mjs", "source": "tools/installer-ui/run-admission.mjs", "match": "createRunAdmissions" },
    "installer-stream": { "label": "installer-stream.mjs", "source": "tools/installer-ui/installer-stream.mjs", "match": "runInstallerStreaming" },
    "transport": { "label": "run-transport.mjs", "source": "tools/installer-ui/run-transport.mjs", "match": "createLineHandler" },
    "installer": { "label": "Install-ClaudeGateway.ps1", "source": "Install-ClaudeGateway.ps1", "match": "$ProgressPath" },
    "steps-producer": { "label": "ClaudeInstallSteps.ps1", "source": "scripts/ClaudeInstallSteps.ps1", "match": "ProgressPath" },
    "preflight-producer": { "label": "ClaudeInstallerPreflight.ps1", "source": "scripts/ClaudeInstallerPreflight.ps1", "match": "checks" },
    "redact": { "label": "Protect-ClaudeInstallText", "source": "scripts/ClaudeInstallResume.ps1", "match": "function Protect-ClaudeInstallText" }
  },
  "groups": [
    { "x": 0, "y": 0, "w": 1440, "h": 300, "tone": "purple", "title": "Launch, browser and shared model" },
    { "x": 0, "y": 340, "w": 1440, "h": 300, "tone": "blue", "title": "Read-only context, preflight and admission" },
    { "x": 0, "y": 690, "w": 1440, "h": 390, "tone": "teal", "title": "Run lifecycle, streaming and stop" }
  ],
  "nodes": [
    { "id": "launch", "x": 24, "y": 78, "w": 320, "h": 190, "tone": "purple", "title": "1 - Local server", "lines": ["[[server]] uses Node http and [[http]] guards requests.", "[[session]] separates bootstrap and session secrets."] },
    { "id": "form", "x": 386, "y": 78, "w": 320, "h": 190, "tone": "purple", "title": "2 - Shared model", "lines": ["[[browser]] and [[server-model]] load [[model]].", "[[schema]] drives field groups and validation."] },
    { "id": "static", "x": 748, "y": 78, "w": 320, "h": 190, "tone": "purple", "title": "3 - Static mode", "lines": ["[[static]] carries the schema for file://.", "No pwsh also reports static mode and live routes return 503."] },
    { "id": "commands", "x": 1110, "y": 78, "w": 306, "h": 190, "tone": "purple", "title": "4 - Portable commands", "lines": ["[[browser-render]] renders commands.", "Address defaults cite [[address-input]]."] },
    { "id": "identity", "x": 24, "y": 422, "w": 320, "h": 220, "tone": "blue", "title": "5 - Account reads", "lines": ["[[identity]] reads JSON.", "No Node az spawn.", "[[lease]] serializes CLI work."] },
    { "id": "prefill", "x": 386, "y": 422, "w": 320, "h": 190, "tone": "blue", "title": "6 - Prefill seams", "lines": ["[[prefill]] lists subscriptions, accounts and deployments.", "Input kind and text parameters are validated before PowerShell starts."] },
    { "id": "preflight", "x": 748, "y": 422, "w": 320, "h": 190, "tone": "blue", "title": "7 - Versioned preflight", "lines": ["[[preflight-producer]] -Preflight -Json is checked by [[contract]].", "Field links use problem paths and x-checkId metadata."] },
    { "id": "fingerprint", "x": 1110, "y": 422, "w": 306, "h": 190, "tone": "blue", "title": "8 - Fingerprint gate", "lines": ["[[fingerprint]] binds answers, engine, scope and identity.", "[[step-scope]] validates selected steps."] },
    { "id": "run", "x": 24, "y": 748, "w": 320, "h": 260, "tone": "teal", "title": "9 - Streamed run", "lines": ["[[browser-run]] reports run summaries.", "[[server]] starts [[installer]] only through pwsh or node stub.", "[[steps-producer]] writes progress NDJSON."] },
    { "id": "record", "x": 386, "y": 768, "w": 320, "h": 240, "tone": "teal", "title": "10 - Run record", "lines": ["[[record]] stores active or last run state and tail.", "[[admission]] records each run request for status.", "Status and attach routes survive browser disconnect."] },
    { "id": "transport", "x": 748, "y": 768, "w": 320, "h": 240, "tone": "teal", "title": "11 - Transport limits", "lines": ["[[installer-stream]] streams installer output through [[transport]].", "[[child-output]] caps read-only output; console output has a 4 MiB cap."] },
    { "id": "stop", "x": 1110, "y": 768, "w": 306, "h": 240, "tone": "teal", "title": "12 - Stop and redaction", "lines": ["Stop uses taskkill.exe on Windows or a POSIX process group.", "server-model.mjs applies [[redact]] rules."] }
  ],
