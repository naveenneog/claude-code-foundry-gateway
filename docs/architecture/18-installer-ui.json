{
  "version": 1,
  "id": "installer-ui",
  "kind": "flow",
  "title": "Installer UI: local server, static fallback and run record",
  "subtitle": "One local Node server and one static page share the UI model, call repository PowerShell seams, gate runs on preflight fingerprints and stream redacted installer progress.",
  "width": 1440,
  "height": 1080,
  "outputs": [
    "docs/images/architecture/installer-ui.png"
  ],
  "sources": [
    "tools/installer-ui/server.mjs",
    "tools/installer-ui/run-record.mjs",
    "tools/installer-ui/run-transport.mjs",
    "tools/installer-ui/installer-contract.mjs",
    "tools/installer-ui/preflight-record.mjs",
    "tools/installer-ui/server-model.mjs",
    "tools/installer-ui/http-helpers.mjs",
    "tools/installer-ui/installer-ui.js",
    "tools/installer-ui/ui-model.js",
    "tools/installer-ui/index.html",
    "schemas/claude-gateway.answers.schema.json",
    "scripts/Get-ClaudeInstallerUiIdentity.ps1",
    "scripts/Get-ClaudeInstallerUiPrefill.ps1",
    "Install-ClaudeGateway.ps1",
    "scripts/ClaudeInstallResume.ps1"
  ],
  "identifiers": {
    "server": { "label": "server.mjs", "source": "tools/installer-ui/server.mjs", "match": "createInstallerUiServer" },
    "http": { "label": "http-helpers.mjs", "source": "tools/installer-ui/http-helpers.mjs", "match": "assertSameOrigin" },
    "browser": { "label": "installer-ui.js", "source": "tools/installer-ui/installer-ui.js", "match": "streamRun" },
    "model": { "label": "ui-model.js", "source": "tools/installer-ui/ui-model.js", "match": "collectAnswersFromEntries" },
    "static": { "label": "index.html", "source": "tools/installer-ui/index.html", "match": "schema-json" },
    "schema": { "label": "answers schema", "source": "schemas/claude-gateway.answers.schema.json", "match": "Claude gateway answers" },
    "server-model": { "label": "server-model.mjs", "source": "tools/installer-ui/server-model.mjs", "match": "loadUiModel" },
    "identity": { "label": "Get-ClaudeInstallerUiIdentity.ps1", "source": "scripts/Get-ClaudeInstallerUiIdentity.ps1", "match": "az account show" },
    "prefill": { "label": "Get-ClaudeInstallerUiPrefill.ps1", "source": "scripts/Get-ClaudeInstallerUiPrefill.ps1", "match": "cognitiveservices" },
    "fingerprint": { "label": "preflight-record.mjs", "source": "tools/installer-ui/preflight-record.mjs", "match": "preflightFingerprint" },
    "contract": { "label": "installer-contract.mjs", "source": "tools/installer-ui/installer-contract.mjs", "match": "validateProgressEvent" },
    "record": { "label": "run-record.mjs", "source": "tools/installer-ui/run-record.mjs", "match": "createRunRecord" },
    "transport": { "label": "run-transport.mjs", "source": "tools/installer-ui/run-transport.mjs", "match": "createLineHandler" },
    "installer": { "label": "Install-ClaudeGateway.ps1", "source": "Install-ClaudeGateway.ps1", "match": "$ProgressPath" },
    "redact": { "label": "Protect-ClaudeInstallText", "source": "scripts/ClaudeInstallResume.ps1", "match": "function Protect-ClaudeInstallText" }
  },
  "groups": [
    { "x": 0, "y": 0, "w": 1440, "h": 300, "tone": "purple", "title": "Launch, browser and shared model" },
    { "x": 0, "y": 340, "w": 1440, "h": 300, "tone": "blue", "title": "Read-only context, preflight and admission" },
    { "x": 0, "y": 690, "w": 1440, "h": 390, "tone": "teal", "title": "Run lifecycle, streaming and static fallback" }
  ],
  "nodes": [
    { "id": "launch", "x": 24, "y": 78, "w": 320, "h": 190, "tone": "purple", "title": "1 - Local server", "lines": ["[[server]] uses Node http.", "[[http]] guards Host, cookie, CSRF, JSON and same-origin."] },
    { "id": "form", "x": 386, "y": 78, "w": 320, "h": 190, "tone": "purple", "title": "2 - Shared model", "lines": ["[[browser]] and [[server-model]] load [[model]].", "[[schema]] drives field groups and validation."] },
    { "id": "static", "x": 748, "y": 78, "w": 320, "h": 190, "tone": "purple", "title": "3 - Static mode", "lines": ["[[static]] carries the schema for file://.", "No pwsh also reports static mode and live routes return 503."] },
    { "id": "commands", "x": 1110, "y": 78, "w": 306, "h": 190, "tone": "purple", "title": "4 - Portable commands", "lines": ["[[model]] renders pwsh commands.", "Bash appears only when bash applies every answer and step."] },
    { "id": "identity", "x": 24, "y": 422, "w": 320, "h": 190, "tone": "blue", "title": "5 - Account reads", "lines": ["[[identity]] reads Azure CLI through PowerShell.", "Node does not spawn az."] },
    { "id": "prefill", "x": 386, "y": 422, "w": 320, "h": 190, "tone": "blue", "title": "6 - Prefill seams", "lines": ["[[prefill]] lists subscriptions, accounts and deployments.", "Input kind and text parameters are validated before PowerShell starts."] },
    { "id": "preflight", "x": 748, "y": 422, "w": 320, "h": 190, "tone": "blue", "title": "7 - Versioned preflight", "lines": ["[[installer]] -Preflight -Json is checked by [[contract]].", "Field links use problem paths and x-checkId metadata."] },
    { "id": "fingerprint", "x": 1110, "y": 422, "w": 306, "h": 190, "tone": "blue", "title": "8 - Fingerprint gate", "lines": ["[[fingerprint]] binds answers, engine and scope.", "A run needs a stored PASS with covering scope."] },
    { "id": "run", "x": 24, "y": 768, "w": 320, "h": 220, "tone": "teal", "title": "9 - Streamed run", "lines": ["[[server]] starts [[installer]] only through pwsh or node stub.", "Selected steps write progress NDJSON."] },
    { "id": "record", "x": 386, "y": 768, "w": 320, "h": 220, "tone": "teal", "title": "10 - Run record", "lines": ["[[record]] stores active or last run state and tail.", "Status and attach routes survive browser disconnect."] },
    { "id": "transport", "x": 748, "y": 768, "w": 320, "h": 220, "tone": "teal", "title": "11 - Transport limits", "lines": ["[[transport]] handles UTF-8, carries and backpressure.", "The server caps console output and long lines."] },
    { "id": "stop", "x": 1110, "y": 768, "w": 306, "h": 220, "tone": "teal", "title": "12 - Stop and redaction", "lines": ["Stop uses taskkill.exe on Windows or a POSIX process group.", "Every outgoing line passes [[redact]]."] }
  ],
  "edges": [
    { "from": "launch", "to": "form", "kind": "data", "points": [[344,170],[386,170]] },
    { "from": "form", "to": "static", "kind": "data", "points": [[706,170],[748,170]] },
    { "from": "static", "to": "commands", "kind": "data", "points": [[1068,170],[1110,170]] },
    { "from": "form", "to": "identity", "kind": "control", "points": [[546,268],[546,370],[184,370],[184,422]] },
    { "from": "identity", "to": "prefill", "kind": "data", "points": [[344,517],[386,517]] },
    { "from": "prefill", "to": "preflight", "kind": "control", "points": [[706,517],[748,517]] },
    { "from": "preflight", "to": "fingerprint", "kind": "data", "points": [[1068,517],[1110,517]] },
    { "from": "fingerprint", "to": "run", "kind": "control", "points": [[1263,612],[1263,710],[184,710],[184,768]] },
    { "from": "run", "to": "record", "kind": "data", "points": [[344,878],[386,878]] },
    { "from": "record", "to": "transport", "kind": "data", "points": [[706,878],[748,878]] },
    { "from": "transport", "to": "stop", "kind": "control", "points": [[1068,878],[1110,878]] },
    { "from": "stop", "to": "record", "kind": "control", "points": [[1263,988],[1263,1032],[546,1032],[546,988]] }
  ]
}
