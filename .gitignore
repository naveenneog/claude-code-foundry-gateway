# generated at deploy time - contains your gateway URL
claude-settings.json

# local tooling
node_modules/
*.log
.DS_Store

# screenshot tooling - browser session cookies and Entra storage state.
# These authenticate as you; never commit them.
.pw-profile/
guide/.auth.json

# Generated onboarding artifacts contain your gateway URL and tenant id.
# Not secret, but environment-specific - regenerate rather than commit.
onboarding/*.html
onboarding/*.txt
onboarding/*.eml
onboarding/*.png
onboarding/claude-gateway.json

# Raw transcripts are inputs to the rendered images; the images are what ship.
docs/transcripts/

# Unredacted screenshot sources. These are captures of a real tenant and carry
# real names, addresses and the signed-in account. guide/redact-entra.mjs turns
# them into the docs/guide/entra-*.png that ship; the originals never do.
.shots-entra/
shots/
shots2/

!onboarding/README.md
