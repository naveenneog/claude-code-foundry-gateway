# generated at deploy time - contains your gateway URL
claude-settings.json

# local tooling
node_modules/
.venv-finops/
.venv-aum-service/
.aum-local/
.finops-research/
__pycache__/
*.egg-info/
.pytest_cache/
.finops-evidence/
finops-reports/
*.log
.DS_Store

# screenshot tooling - browser session cookies and Entra storage state.
# These authenticate as you; never commit them.
.pw-profile/
guide/.auth.json

# Generated onboarding artifacts contain your gateway URL and tenant id.
# Not secret, but environment-specific - regenerate rather than commit.
onboarding/*.html
onboarding/*.txt
onboarding/*.eml
onboarding/*.png
onboarding/claude-gateway.json
onboarding/aum-service.json

# Raw transcripts are inputs to the rendered images; the images are what ship.
docs/transcripts/

# Unredacted screenshot sources. These are captures of a real tenant and carry
# real names, addresses and the signed-in account. guide/redact-entra.mjs turns
# them into the docs/guide/entra-*.png that ship; the originals never do.
.shots-entra/
# Any raw capture staged for the banner treatment. The redacted copy goes to
# docs/guide; the original never lands in a commit.
.shots-*.png
shots/
shots2/

# Gateway configuration backups. No secrets - Backup-ClaudeGateway.ps1 reads the
# plain named value list, which omits them - but they still carry entitlement
# object ids, the tenant id and the live budgets of a real deployment.
backups/

# Claude Code conversation backups. These are prompts and source code.
claude-code-backups/

!onboarding/README.md

# The price book is per-deployment and may hold negotiated rates rather than
# list price, which is commercially sensitive. config/price-book.example.json
# ships instead, and scripts/ClaudeBusinessUnit.ps1 falls back to built-in list
# rates when no file is present.
config/price-book.json

# Personal usage reports and private live evidence. Only Contoso fixtures ship.
/chargeback-reports/
.chargeback-*/
