      "target": { "discover": "gateway", "selectionKey": "gateway" },
      "blade": "/overview",
      "waitFor": { "text": "Gateway URL" },
      "settle": 6000,
      "redaction": { "mapEnv": "PORTAL_REDACTIONS_FILE" }
    },
    {
      "id": "docs-review-foundry-iam",
