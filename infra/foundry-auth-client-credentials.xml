<cache-lookup-value
    key="foundry-token:__FOUNDRY_TENANT_ID__:__FOUNDRY_CLIENT_ID__"
    variable-name="foundry-token" />
<choose>
    <when condition="@(!context.Variables.ContainsKey(&quot;foundry-token&quot;))">
        <send-request mode="new" response-variable-name="foundry-token-response" timeout="20" ignore-error="false">
            <set-url>https://login.microsoftonline.com/__FOUNDRY_TENANT_ID__/oauth2/v2.0/token</set-url>
            <set-method>POST</set-method>
            <set-header name="Content-Type" exists-action="override">
                <value>application/x-www-form-urlencoded</value>
            </set-header>
            <set-body>@("client_id=__FOUNDRY_CLIENT_ID__&amp;client_secret=" + System.Net.WebUtility.UrlEncode("__FOUNDRY_CLIENT_SECRET_NAMED_VALUE__") + "&amp;scope=https%3A%2F%2Fcognitiveservices.azure.com%2F.default&amp;grant_type=client_credentials")</set-body>
        </send-request>
        <choose>
            <when condition="@(((IResponse)context.Variables[&quot;foundry-token-response&quot;]).StatusCode != 200)">
                <return-response>
                    <set-status code="503" reason="Foundry token acquisition failed" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"error":{"type":"foundry_token_failed","message":"The gateway could not obtain its Foundry token. Ask the platform administrator to verify the cross-tenant application credential."}}</set-body>
                </return-response>
            </when>
        </choose>
        <set-variable name="foundry-token" value="@(((IResponse)context.Variables[&quot;foundry-token-response&quot;]).Body.As&lt;JObject&gt;()[&quot;access_token&quot;].ToString())" />
        <cache-store-value
            key="foundry-token:__FOUNDRY_TENANT_ID__:__FOUNDRY_CLIENT_ID__"
            value="@((string)context.Variables[&quot;foundry-token&quot;])"
            duration="3000" />
    </when>
</choose>
<set-header name="Authorization" exists-action="override">
    <value>@("Bearer " + (string)context.Variables["foundry-token"])</value>
</set-header>
