{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "functionTimeout": "00:05:00",
  "logging": {
    "logLevel": {"default": "Warning", "Host.Results": "Information"},
    "applicationInsights": {
      "samplingSettings": {"isEnabled": true, "excludedTypes": "Exception"}
    }
  }
}
